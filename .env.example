# Server-only. Never prefix with VITE_ — anything VITE_* is bundled into the browser.

# Funded Tiramisu dev EOA that drips test GLM to new members. Generate with:
#   npx tsx scripts/new-dev-key.ts DRIP_PRIVATE_KEY
DRIP_PRIVATE_KEY=
# GLM sent per new member address
DRIP_AMOUNT_GLM=0.02
# Refuse the drip if the address already holds at least this much
DRIP_MAX_RECIPIENT_BALANCE_GLM=0.005
# Optional: override the RPC (defaults to the public Tiramisu RPC)
ARKIV_RPC_URL=
