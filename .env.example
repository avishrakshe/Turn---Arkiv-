# Server-only. Never prefix with NEXT_PUBLIC_: anything NEXT_PUBLIC_* is bundled into the browser.

# Funded Tiramisu dev EOA that drips test GLM to new members (and signs the seed's GLM transfers).
# Generate with:  npx tsx scripts/new-dev-key.ts DRIP_PRIVATE_KEY
DRIP_PRIVATE_KEY=
# GLM sent per new member address (one drip per address; any existing balance refuses)
DRIP_AMOUNT_GLM=0.02
# Refuse the drip if the address already holds at least this much
DRIP_MAX_RECIPIENT_BALANCE_GLM=0.005

# Arkiv access key from https://hub.arkiv.network. Used server-side only: by /api/rpc (the app's
# fallback when the anonymous RPC budget is exhausted), /api/drip, and the seed/smoke scripts.
ARKIV_API_KEY=
# Optional: override the RPC (defaults to the public Tiramisu RPC)
ARKIV_RPC_URL=
